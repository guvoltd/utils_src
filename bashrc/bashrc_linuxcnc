function melinuxcnc() {
    if [ "$#" -ge 1 ]; then
        text=$1
        count=0
        logFile=1
	    if [ "$#" -eq 2 ]; then
            if [ "$2" -gt 3 ]; then
                count=3
            else
                count=$2
            fi
        fi
        #cd ~/linuxcnc/$text/src/
        cd $text/src/

	    if [ "$count" -ge 3 ]; then
            echo "make clean"
            make clean
            if [ "$?" -ne 0 ]; then
                echo "Error: 'make clean' failed."
                return 1
            fi
            logFile=1
            count=$((count - 1))
        fi

        if [ "$count" -eq 2 ]; then
            echo "autogen.sh"
            
            ./autogen.sh
            if [ "$?" -ne 0 ]; then
                echo "Error: './autogen.sh' failed."
                return 1
            fi
            
            ./configure --with-realtime=uspace --disable-build-documentation-translation
            if [ "$?" -ne 0 ]; then
                echo "Error: './configure' failed."
                return 1
            fi
            count=$((count - 1))
        fi
	
        if [ "$count" -eq 1 ]; then
            echo "make"
            make -j4
            if [ "$?" -ne 0 ]; then
                echo "Error: 'make' failed."
                return 1
            fi
            sudo make setuid 
            if [ "$?" -ne 0 ]; then
                echo "Error: 'sudo make setuid' failed."
                return 1
            fi
            count=$((count - 1))
        fi

        if [ "$count" -eq 0 ]; then
            echo "Run Linuxcnc"
            cd ..
            source scripts/rip-environment
            if [ "$?" -ne 0 ]; then
                echo "Error: Source environment failed."
                return 1
            fi
            if [ "$logFile" -eq 1 ]; then
                #logFile=~/linuxcnc/$text/log_txt.txt
                logFile=log_txt.txt
                #linuxcnc -d  ~/linuxcnc/$text/configs/sim/axis/axis_mm.ini > $logFile
                echo "Running linuxcnc with ini: $text/configs/sim/axis/axis_mm_scurve.ini"
                linuxcnc -d  configs/sim/axis/axis_mm_scurve.ini > $logFile
            else
                linuxcnc -d
            fi
        fi

    else
        echo "Usage: melinuxcnc foldername <number>"
        echo "Provide minimum  1  argument: 'foldername' a folder name from location '~/linuxcnc/'."
        echo "<number>: '3': make clean before next steps, '2': autogen, configure command and follow next steps,"
        echo "'1': Make and follow next steps, '0'/ skipped number argument, source env and run linuxcnc,"
	echo "<number> = 'l'/'log', source env and run linuxcnc with capture log into log_txt.txt file, log file path current directory."
    fi
}

